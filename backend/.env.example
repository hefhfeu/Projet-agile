# ==============================================================================
# Configuration de la Base de Données PostgreSQL — Usine TWIN_3
# ==============================================================================

# Connexion PostgreSQL
DB_ENGINE=django.db.backends.postgresql
DB_NAME=usine_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Option de bascule rapide sur SQLite pour test local sans serveur PostgreSQL démarré
USE_SQLITE=False

# Django Security
DJANGO_SECRET_KEY=django-insecure-twin3-usine-prod-secret-key-agile-dev-2026
DJANGO_DEBUG=True

